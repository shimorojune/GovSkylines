# Anthropic API key for the departments
ANTHROPIC_API_KEY=

# The cabinet spawns ../mcp-server over stdio. Override only if it lives elsewhere.
# GOVSKYLINES_MCP_DIR=..\\mcp-server

# Optional: must match the bridge's port / token if you changed them
# CS2_BRIDGE_URL=http://127.0.0.1:8642
# CS2MCP_TOKEN=

# Model and effort for department agents
CABINET_MODEL=claude-opus-5-5
CABINET_EFFORT=medium

# Set to "true" to skip the approval prompt for write tools (don't, at first)
AUTO_APPROVE=false
